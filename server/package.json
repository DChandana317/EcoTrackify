{
  "name": "ecotrackify-server",
  "version": "1.0.0",
  "description": "Ecotrackify backend API (Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "lint": "eslint \"src/**/*.js\"",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "npm test -- --watch",
    "seed": "node src/scripts/seed.js"
  },
  "keywords": [
    "carbon",
    "sustainability",
    "express",
    "mongodb"
  ],
  "author": "Ecotrackify Team",
  "license": "MIT",
  "dependencies": {
    "agenda": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "celebrate": "^16.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.0",
    "morgan": "^1.10.1",
    "nodemailer": "^10.0.10",
    "validator": "^13.15.23"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4"
  }
}
